{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/json/schemas/domains/sjp/command/sjp.upload-case-document.json",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string"
    },
    "caseDocument": {
      "type": "string"
    },
    "caseDocumentUri": {
      "type": "string",
      "format": "uri"
    },
    "caseDocumentType": {
      "type": "string"
    }
  },
  "required": [
    "caseId",
    "caseDocumentType"
  ],
  "oneOf": [
    {
      "required": [
        "caseDocument"
      ]
    },
    {
      "required": [
        "caseDocumentUri"
      ]
    }
  ]
}
