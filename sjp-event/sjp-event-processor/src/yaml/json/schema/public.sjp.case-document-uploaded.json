{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/sjp/json/schema/event/public-case-document-uploaded.json",
  "type": "object",
  "properties": {
    "documentId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "documentUri": {
      "type": "string",
      "format": "uri"
    },
    "caseId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    }
  },
  "required": [
    "caseId"
  ],
  "oneOf": [
    {
      "required": [
        "documentId"
      ]
    },
    {
      "required": [
        "documentUri"
      ]
    }
  ]
}
