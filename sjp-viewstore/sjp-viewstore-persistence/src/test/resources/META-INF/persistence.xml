<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <!-- Build-time (Surefire) test persistence unit for the repository tests: real JPA against an
         in-memory H2, schema generated from the entities (hbm2ddl create). No database/docker required.
         Used via HibernateTestEntityManagerProvider (post DeltaSpike Data -> plain JPA migration). -->
    <persistence-unit name="sjp-test-persistence-unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jar-file>../classes</jar-file>
        <class>uk.gov.moj.cpp.sjp.persistence.entity.converter.TimestampConverter</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:sjptest;DB_CLOSE_DELAY=-1;NON_KEYWORDS=VALUE,COMMENT,YEAR,MONTH,DAY,USER,KEY"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.archive.autodetection" value="class"/>
            <property name="hibernate.hbm2ddl.auto" value="create"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
